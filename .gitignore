# 本地密钥：只能留在自己的电脑上，不能提交到 Git。
.env

# 长期记忆保存本机画像与项目事实，代码仓库只提交机制，不提交私人正文。
memory/

# 编辑器目录（PyCharm 等），不含源码，不提交。
.idea/

# Python 虚拟环境和运行缓存。
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# SQLite 会保存真实对话，不应提交到代码仓库。
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# 本机桌面双击启动入口，只跟本机路径有关，不提交。
run_cli.cmd

# Agent 运行后在工作区中新建的文件默认不提交。
workspace/*
!workspace/knowledge/
workspace/knowledge/*
!workspace/knowledge/common_agent_facts.md
