# 复制本文件为 .env，再填入自己的模型配置。
# 只要供应商兼容 OpenAI Chat Completions 接口，就可以接入。
LLM_API_KEY=请填写你的密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 换模型时必须按该模型的官方最大输入长度修改。
LLM_MAX_INPUT_TOKENS=991808

# 单向模型交接的 fast / strong 使用同一个地址和密钥；四项必填，名称与窗口必须成对配置。
# fast 用 qwen3.8-flash，strong 用 qwen3.8-max；须先开通对应模型。
# 两者上下文窗口都是 1M token，普通模式最大输入为 991808；131072 是最大输出，不是输入。
# Flash 思考模式最大输入为 983616，示例采用该保守值；换模型或模式时核对官方输入上限。
LLM_FAST_MODEL=qwen3.8-flash
LLM_FAST_MAX_INPUT_TOKENS=983616
LLM_STRONG_MODEL=qwen3.8-max
LLM_STRONG_MAX_INPUT_TOKENS=991808

# RAG 使用百炼当前通用文本向量模型；1024 维兼顾效果、存储和计算量。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 百炼 qwen3-rerank 的 OpenAI 兼容接口（2026-09-28 实测可用，无需业务空间 ID）。
# 注意：这里必须是 compatible-api，不是聊天用的 compatible-mode；
# compatible-mode/v1/reranks 会返回 404。
RERANK_API_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks

# ---------- 可选：向量与重排走另一套端点 ----------
# 对话和向量可以不共用端点。比如对话用套餐专属端点（套餐不提供向量与重排，
# 且套餐 key 打通用地址会 401），向量和重排仍走通用端点，此时单独配下面三项。
# 留空或不配时，自动回落到上面的 LLM_API_KEY / LLM_BASE_URL。
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANK_API_KEY=
