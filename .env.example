# 复制本文件为 .env，再填入自己的模型配置。
# 只要供应商兼容 OpenAI Chat Completions 接口，就可以接入。
LLM_API_KEY=请填写你的密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-27b
# 换模型时必须按该模型的官方最大输入长度修改。
LLM_MAX_INPUT_TOKENS=991808

# RAG 使用百炼当前通用文本向量模型；1024 维兼顾效果、存储和计算量。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
